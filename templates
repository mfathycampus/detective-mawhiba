<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🔍 المحقق الرقمي — موهبة 2026</title>
<link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>

<!-- ═══ SPLASH SCREEN ═══ -->
<div id="splash">
  <div class="splash-card">
    <div class="logo">🔍</div>
    <h1>المحقق الرقمي</h1>
    <p class="sub">مؤسسة موهبة — برمجة الحاسب 2026</p>
    <p class="story">سُرقت قاعدة بيانات مشفرة من مكتبة الأكواد.<br>مهمتك: فك الشيفرات، تتبّع الأدلة، واكشف المجرم!</p>
    <input type="text" id="detective-name" placeholder="ما اسم محققنا؟" maxlength="30" autofocus>
    <button class="btn-start" onclick="startGame()">ابدأ التحقيق ←</button>
  </div>
</div>

<!-- ═══ MAIN GAME ═══ -->
<div id="game" class="hidden">

  <!-- Header -->
  <header>
    <div class="header-left">
      <span class="logo-sm">🔍</span>
      <span id="h-name" class="h-name"></span>
    </div>
    <div class="header-stats">
      <span class="stat-pill">⏱ <span id="h-time">0:00</span></span>
      <span class="stat-pill">⭐ <span id="h-score">100</span></span>
      <span class="stat-pill">📋 <span id="h-clues">0</span> أدلة</span>
      <span class="stat-pill">💡 <span id="h-hints">3</span> تلميح</span>
    </div>
  </header>

  <!-- Body -->
  <div class="game-body">

    <!-- Sidebar: suspects -->
    <aside class="sidebar">
      <h3>ملفات المشتبهين</h3>
      <div id="suspects-list"></div>
      <div class="action-log">
        <h4>سجل الأحداث</h4>
        <ul id="action-log"></ul>
      </div>
    </aside>

    <!-- Main panel -->
    <main class="main-panel">

      <!-- Mission tabs -->
      <nav class="tabs">
        <button class="tab active" data-tab="cipher">🔐 فك التشفير</button>
        <button class="tab" data-tab="search">🔍 البحث</button>
        <button class="tab" data-tab="clues">🔬 الأدلة</button>
        <button class="tab" data-tab="pascal">🔺 باسكال</button>
        <button class="tab" data-tab="verdict">⚖ الحكم</button>
        <button class="tab" data-tab="report">💾 التقرير</button>
      </nav>

      <!-- Tab: Cipher -->
      <section id="tab-cipher" class="tab-content active">
        <h2>🔐 مهمة 1 — فك تشفير الرسالة السرية</h2>
        <p class="mission-desc">وجدنا هذه الرسالة في مسرح الجريمة. هي مشفرة بشيفرة قيصر.</p>
        <div class="cipher-box">
          <span class="cipher-label">الرسالة المشفرة:</span>
          <div class="cipher-text" id="secret-msg">PHKWDU LV DW WKH OLEUDUB</div>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="cipherAuto()">🤖 كسر تلقائي (جرّب كل الإزاحات)</button>
          <button class="btn btn-outline" onclick="showManual()">✏️ جرّب إزاحة محددة</button>
          <button class="btn btn-hint" onclick="cipherHint()">💡 تلميح (-10 نقاط)</button>
        </div>
        <div id="manual-input" class="hidden mt1">
          <label>الإزاحة (1-25):</label>
          <input type="number" id="shift-val" min="1" max="25" value="3" style="width:80px">
          <button class="btn btn-sm" onclick="cipherManual()">جرّب</button>
          <div id="manual-result" class="result-box hidden"></div>
        </div>
        <div id="cipher-results" class="hidden mt1"></div>
      </section>

      <!-- Tab: Search -->
      <section id="tab-search" class="tab-content hidden">
        <h2>🔍 مهمة 2 — البحث في قاعدة المشتبهين</h2>
        <p class="mission-desc">ابحث عن مشتبه وقارن سرعة البحث الخطي والثنائي.</p>
        <div class="search-row">
          <input type="text" id="search-input" placeholder="اسم المشتبه..." list="suspects-datalist">
          <datalist id="suspects-datalist">
            <option value="Mehtar"><option value="Lena"><option value="Omar"><option value="Sara">
          </datalist>
          <button class="btn" onclick="doSearch('binary')">🔍 بحث ثنائي</button>
          <button class="btn btn-outline" onclick="doSearch('linear')">🐢 بحث خطي</button>
          <button class="btn btn-outline" onclick="doSearch('both')">📊 قارن</button>
        </div>
        <div id="search-result" class="mt1"></div>
        <div id="search-viz" class="search-viz hidden mt1"></div>
      </section>

      <!-- Tab: Clues -->
      <section id="tab-clues" class="tab-content hidden">
        <h2>🔬 مهمة 3 — تحليل الأدلة</h2>
        <p class="mission-desc">الأدلة مرتبة تنازلياً حسب الأهمية. اضغط لإضافة دليل لملف المشتبه.</p>
        <div id="clues-list"></div>
      </section>

      <!-- Tab: Pascal -->
      <section id="tab-pascal" class="tab-content hidden">
        <h2>🔺 مهمة 4 — مثلث باسكال كمفتاح تشفير</h2>
        <p class="mission-desc">مجموع الصف الأخير mod 26 يعطي مفتاح تشفير ثانٍ.</p>
        <div class="row-center mt1">
          <label>عدد الصفوف:</label>
          <input type="range" id="pascal-rows" min="3" max="8" value="5" oninput="document.getElementById('pascal-rows-val').textContent=this.value" style="width:140px">
          <span id="pascal-rows-val">5</span>
          <button class="btn btn-sm" onclick="doPascal()">احسب</button>
        </div>
        <div id="pascal-result" class="mt1"></div>
      </section>

      <!-- Tab: Verdict -->
      <section id="tab-verdict" class="tab-content hidden">
        <h2>⚖ مهمة 5 — إصدار الحكم النهائي</h2>
        <p class="mission-desc">من هو المجرم؟ اختر بناءً على ما جمعته من أدلة. الحكم الخاطئ يخفض نقاطك 20!</p>
        <div id="verdict-suspects" class="verdict-grid"></div>
        <div id="verdict-result" class="hidden mt1"></div>
      </section>

      <!-- Tab: Report -->
      <section id="tab-report" class="tab-content hidden">
        <h2>💾 تقرير التحقيق</h2>
        <button class="btn" onclick="loadReport()">📋 أنشئ التقرير</button>
        <pre id="report-content" class="report-pre hidden mt1"></pre>
      </section>

    </main>
  </div>
</div>

<!-- Win Modal -->
<div id="win-modal" class="modal hidden">
  <div class="modal-card">
    <div class="win-emoji">🏆</div>
    <h2 id="win-title">أحسنت!</h2>
    <p id="win-msg"></p>
    <div class="win-stats" id="win-stats"></div>
    <button class="btn-start" onclick="closeModal()">تابع التحقيق</button>
  </div>
</div>

<script src="{{ url_for('static', filename='js/game.js') }}"></script>
</body>
</html>
